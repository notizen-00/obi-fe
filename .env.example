# URL endpoint API CBT yang dapat diakses oleh browser pengguna.
PUBLIC_CBT_API_BASE_URL=http://obi-archive.test/_/api.php
PUBLIC_CBT_SERVER_TIMEZONE=Asia/Jakarta

# Port publik container di host.
APP_PORT=3000

# URL publik aplikasi. Ganti dengan domain HTTPS saat deployment.
ORIGIN=http://localhost:3000